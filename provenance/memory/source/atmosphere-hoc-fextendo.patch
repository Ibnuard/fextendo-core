new file mode 100644
index 0000000..4afaedb
--- /dev/null
+++ b/stratosphere/loader/source/oc/pcv/pcv.hpp
@@ -0,0 +1,207 @@
+/*
+ * Copyright (C) Switch-OC-Suite
+ *
+ * Copyright (c) 2023 hanai3Bi
+ *
+ * Copyright (c) Souldbminer, Lightos_ and Horizon OC Contributors
+ *
