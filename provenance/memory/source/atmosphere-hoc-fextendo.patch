+            PATCH_OFFSET(ptr + 3, C.eristaCpuVmin);
+            PATCH_OFFSET(ptr + 6, C.eristaCpuVmin);
+        }
+
+        if (C.eristaCpuMaxVolt) {
+            PATCH_OFFSET(ptr - 2, C.eristaCpuMaxVolt);
