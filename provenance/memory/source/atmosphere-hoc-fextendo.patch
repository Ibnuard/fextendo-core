diff --git a/stratosphere/loader/source/oc/oc_common.hpp b/stratosphere/loader/source/oc/oc_common.hpp
new file mode 100644
index 0000000..54fe7b7
--- /dev/null
+++ b/stratosphere/loader/source/oc/oc_common.hpp
@@ -0,0 +1,127 @@
+/*
